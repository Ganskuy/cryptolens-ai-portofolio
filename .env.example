# Copy to .env (chmod 600). Never commit credentials.
DATABASE_URL=postgresql+psycopg://cryptolens:local-development-only@postgres:5432/cryptolens
POSTGRES_PASSWORD=local-development-only
REDIS_URL=redis://redis:6379/0
DATA_MODE=live
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v3.2
AI_ENABLED=false
AI_TOTAL_TOKEN_LIMIT=100000
AI_DAILY_USD_LIMIT=2
POLL_SECONDS=300
COOKIE_SECURE=false

AUTH_MODE=local
DEPLOYMENT_MODE=local
ALLOWED_ORIGIN=http://localhost:3100
MARKET_WS_URL=ws://localhost:8100/api/v1/stream/market
AI_MODE=grounded
AI_NARRATION=false
ANALYTICS_RETENTION_DAYS=30
DAILY_RETENTION_DAYS=1826
HOURLY_RETENTION_DAYS=90
UNIVERSE_PAGES=4
UNIVERSE_POLL_SECONDS=3600
STREAM_ROTATION_SECONDS=82800
