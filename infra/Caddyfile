https://localhost:8443 {
    tls internal
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy same-origin
    }
    @api path /api/*
    handle @api {
        reverse_proxy backend:8000 {
            flush_interval -1
        }
    }
    handle /metrics {
        respond 404
    }
    handle {
        reverse_proxy frontend:3100
    }
}
